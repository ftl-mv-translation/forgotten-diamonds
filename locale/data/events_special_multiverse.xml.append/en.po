#: src-en/data/events_special_multiverse.xml.append:350
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
"append:choice[2]/text"
msgstr "Present a copper drone."

#: src-en/data/events_special_multiverse.xml.append:352
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
"append:choice[2]/event/text"
msgstr ""
"\"A...DRONE?! WHO do you think I AM Renegade?! If Thest hadn't BANNED me "
"from killing you lot I would have CRUSHED your puny head with my FISTS! "
"Unfortunately, I am BOUND by the CREED to give you a BOON, even for a "
"offering as PITIFUL as this RUSTING DRONE, nevertheless I shall BLESS you "
"with the BLESSING OF RUSTING. But have PATIENCE. It is not for now, but for "
"LATER!\""

#: src-en/data/events_special_multiverse.xml.append:356
msgid ""
