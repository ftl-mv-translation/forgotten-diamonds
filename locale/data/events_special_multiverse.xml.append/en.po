msgstr "Present a golden weapon."

#: src-en/data/events_special_multiverse.xml.append:340
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
"append:choice[1]/event/text"
msgstr ""
"\"This... this weapon is... It doesn't make any SENSE to me! It bears the "
"MARKS of the FOREFATHERS, YET it's BUILT completely DIFFERENTLY from "
"anything they ever MADE! Very WELL then, I shall BLESS you with the BLESSING"
" OF OPULENCE. But have PATIENCE. It is not for now, but for LATER!\""

#: src-en/data/events_special_multiverse.xml.append:344
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
