msgstr "Présentez une arme dorée."

#: src-en/data/events_special_multiverse.xml.append:307
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
"append:choice[1]/event/text"
msgstr ""
"\" Cette... cette arme est... Elle n'a aucun SENS pour moi ! Elle porte les "
"MARQUES des ANCÊTRES, ET pourtant elle est CONSTRUITE complètement "
"DIFFÉREMMENT de tout ce qu'ils ont jamais FABRIQUÉ ! Très BIEN alors, je "
"vous BÉNIRAI avec la BÉNÉDICTION D'OPULENCE. Mais ayez PATIENCE. Ce n'est "
"pas pour maintenant, mais pour PLUS TARD ! \""

#: src-en/data/events_special_multiverse.xml.append:311
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
