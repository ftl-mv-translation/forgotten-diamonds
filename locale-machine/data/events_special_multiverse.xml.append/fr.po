msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
"append:choice[3]/text"
msgstr "Présentez le Façonneur de Chair."

#: src-en/data/events_special_multiverse.xml.append:331
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
"append:choice[3]/event/text"
msgstr ""
"\" AHAHAHAHA ! QU'EST-CE QUE C'EST ?! Une AUGMENTATION qui peut créer de "
"l'ÉQUIPAGE à partir de CARBURANT ?! AHAHAHA ! Renégat, je vous remercie pour"
" le DIVERTISSEMENT que vous m'avez procuré en me montrant CELA ! AHAHAH ! "
"Oui, c'est UN hommage ! Je vous BÉNIRAI avec la BÉNÉDICTION DE CLONAGE. Mais"
" ayez PATIENCE. Ce n'est pas pour maintenant, mais pour PLUS TARD ! \""

#: src-en/data/events_special_multiverse.xml.append:335
