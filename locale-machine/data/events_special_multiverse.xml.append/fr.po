msgstr ""

#: src-en/data/events_special_multiverse.xml.append:317
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
"append:choice[2]/text"
msgstr "Présentez un drone de cuivre."

#: src-en/data/events_special_multiverse.xml.append:319
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
"append:choice[2]/event/text"
msgstr ""
"\" UN... DRONE ?! POUR QUI me prenez-vous, Renégat ?! Si Thest ne m'avait "
"pas INTERDIT de vous tuer, je vous aurais ÉCRASÉ la misérable tête avec mes "
"POINGS ! Malheureusement, je suis LIÉ par le CREDO de vous accorder une "
"FAVEUR, même pour une offre aussi PITOYABLE que ce DRONE ROUILLEUX, "
"néanmoins je vous BÉNIRAI avec la BÉNÉDICTION DE ROUILLE. Mais ayez "
"PATIENCE. Ce n'est pas pour maintenant, mais pour PLUS TARD ! \""

#: src-en/data/events_special_multiverse.xml.append:323
msgid ""
"data/events_special_multiverse.xml.append$//mod:findName[@name=\"THE_JUDGES_ROCKMAN_REAL\"]/mod-"
